{
  "name": "prism",
  "version": "1.0.4",
  "description": "Multimodal AI playground on Cloudflare Workers: chat, voice, image/video/music generation, RAG, and web search.",
  "license": "AGPL-3.0-only",
  "author": "Conrad Rockenhaus",
  "homepage": "https://play.skyphusion.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyphusion-labs/prism.git"
  },
  "bugs": {
    "url": "https://github.com/skyphusion-labs/prism/issues"
  },
  "keywords": [
    "cloudflare-workers",
    "llm",
    "multimodal",
    "rag",
    "voice-chat",
    "workers-ai",
    "self-hosted",
    "ai-playground"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "bootstrap": "node -e \"const fs=require('fs');if(fs.existsSync('wrangler.toml')){console.error('wrangler.toml already exists; not overwriting.');process.exit(1)}fs.copyFileSync('wrangler.example.toml','wrangler.toml');console.log('Created wrangler.toml from wrangler.example.toml. Fill in database_id (and worker name if you want a custom one) before deploying.')\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create skyphusion-llm",
    "db:migrate:local": "wrangler d1 execute skyphusion-llm --local --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute skyphusion-llm --remote --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.120.0"
  },
  "dependencies": {
    "unpdf": "^1.8.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "undici": "7.29.0"
  }
}
